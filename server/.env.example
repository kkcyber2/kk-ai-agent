# Copy to .env and fill in. Nothing here is required for the tests to pass.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: only needed for AI-drafted replies and sentiment analysis.
OPENAI_API_KEY=

# Social platform OAuth apps
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/auth/instagram/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/auth/facebook/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

PORT=3001
NODE_ENV=development
